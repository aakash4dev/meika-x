# ---------------------------------------------------------------------------
# MEIKA-X configuration. Copy to .env.local and fill in what you have.
# Supabase is required; every other key is optional: missing keys switch features off, never crash.
# ---------------------------------------------------------------------------

# --- Supabase (database + file storage for satellite snapshots) — REQUIRED
# Local: `npm run db:start` (needs Docker), then copy API URL -> NEXT_PUBLIC_SUPABASE_URL and
# Secret key -> SUPABASE_SECRET_KEY.  (`npm run db:status` prints them again.)
# Vercel: add the Supabase integration (it sets these; the older SUPABASE_SERVICE_ROLE_KEY name also works),
# or paste them from Supabase Dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Server only. Never expose it in the browser or commit it.
SUPABASE_SECRET_KEY=

# --- Claude (AI features: Chief Detective planning, Narrator, Witness vision, digests)
# Option A: an Anthropic API key (needed for a deployed site).
ANTHROPIC_API_KEY=
# Model used by both options. Default: claude-opus-5-5
CLAUDE_MODEL=claude-opus-5-5
# Option B: your local Claude Code CLI (`claude`), used when no API key is set.
# Set to "off" to disable. Default: auto (use it if it is on PATH).
CLAUDE_CLI=auto

# Option C: DeepSeek via Hugging Face Inference Providers, used when neither A nor B is available
# (e.g. on Vercel without an Anthropic key). Token: huggingface.co/settings/tokens > Fine-grained >
# "Make calls to Inference Providers". Text only: the satellite visual note is skipped.
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# --- Telegram alerts (from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Active monitoring
# Minutes between automatic monitoring runs while the server is up. 0 = manual / cron only.
# Ignored on Vercel, where Vercel Cron calls /api/monitor/run (see vercel.json; it sends CRON_SECRET).
MONITOR_INTERVAL_MINUTES=60
# Secret for scheduled runs: Vercel Cron sends it as a Bearer token; other crons use GET /api/monitor/run?secret=...
CRON_SECRET=change-me

# --- Optional NASA keys
# FIRMS active-fire MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# api.nasa.gov key (optional; not required by current features)
NASA_API_KEY=
